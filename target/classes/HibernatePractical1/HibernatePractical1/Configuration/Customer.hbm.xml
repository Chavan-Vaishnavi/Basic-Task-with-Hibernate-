<!DOCTYPE hibernate-mapping PUBLIC 
    "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
    "http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">
    
    <hibernate-mapping>
    	<class name="HibernatePractical1.HibernatePractical1.Model.Customer" table="Customer_info">
    	<id name="cid" column="cust_id"></id>
    	<property name="cname" column="cust_name"></property>
    	<property name="cemail" column="cust_email"></property>
    	<property name="cphone" column="cust_phone"></property>
    	</class>
    </hibernate-mapping>